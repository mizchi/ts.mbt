# Node.js
node_modules/

# Resolver package fixtures intentionally live under a fixture node_modules tree.
# pkg-* gets a glob; named scopes / dotted dirs / symlinks need explicit lines.
!fixtures/resolver/project/node_modules/
fixtures/resolver/project/node_modules/*
!fixtures/resolver/project/node_modules/.pnpm/
!fixtures/resolver/project/node_modules/.pnpm/**
!fixtures/resolver/project/node_modules/@scope/
!fixtures/resolver/project/node_modules/@scope/**
!fixtures/resolver/project/node_modules/@types/
!fixtures/resolver/project/node_modules/@types/**
!fixtures/resolver/project/node_modules/hono/
!fixtures/resolver/project/node_modules/hono/**
!fixtures/resolver/project/node_modules/neverthrow-like
!fixtures/resolver/project/node_modules/pkg-*
!fixtures/resolver/project/node_modules/pkg-*/**
!fixtures/resolver/project/node_modules/react/
!fixtures/resolver/project/node_modules/react/**

